<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SwishVision" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/court</item>
        <item name="android:statusBarColor">@color/court</item>
        <item name="android:navigationBarColor">@color/court</item>
        <item name="colorPrimary">@color/amber</item>
        <item name="colorAccent">@color/amber</item>
    </style>

    <style name="Stat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="PanelButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/net</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Chip" parent="PanelButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
